### 5.4 Python

```python
import httpx

KEYCLOAK_URL = "https://auth.example.com/realms/spr/protocol/openid-connect/token"
BASE_URL = "https://api.example.com"
CLIENT_ID = "portal-pwd-external"
CLIENT_SECRET = "your-client-secret"
USERNAME = "pwd_external_user"
PASSWORD = "your-password"


def get_access_token() -> str:
    response = httpx.post(
        KEYCLOAK_URL,
        data={
            "grant_type": "password",
            "client_id": CLIENT_ID,
            "client_secret": CLIENT_SECRET,
            "username": USERNAME,
            "password": PASSWORD,
        },
    )
    response.raise_for_status()
    return response.json()["access_token"]


def update_record(disability_code: str, payload: dict, token: str) -> dict:
    response = httpx.put(
        f"{BASE_URL}/api/v1/main/status/{disability_code}",
        json=payload,
        headers={"Authorization": f"Bearer {token}"},
    )
    response.raise_for_status()
    return response.json()


# ── Usage ──
token = get_access_token()

# Status only
result = update_record("PWD-2026-001234", {"new_status": "PWD_APPROVED"}, token)
print(result)

# Status + fields
result = update_record(
    "PWD-2026-005678",
    {
        "new_status": "PWD_MODIFIED",
        "family_name": "សុខ",
        "given_name": "វិចិត្រ",
        "phone_number": "0987654321",
        "remarks": "កែតម្រូវទិន្នន័យ",
    },
    token,
)
print(result)
```

### 5.5 JavaScript (Node.js / Fetch)

```javascript
const KEYCLOAK_URL = "https://auth.example.com/realms/spr/protocol/openid-connect/token";
const BASE_URL = "https://api.example.com";
const CLIENT_ID = "portal-pwd-external";
const CLIENT_SECRET = "your-client-secret";
const USERNAME = "pwd_external_user";
const PASSWORD = "your-password";

async function getAccessToken() {
  const body = new URLSearchParams({
    grant_type: "password",
    client_id: CLIENT_ID,
    client_secret: CLIENT_SECRET,
    username: USERNAME,
    password: PASSWORD,
  });

  const res = await fetch(KEYCLOAK_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body,
  });

  if (!res.ok) throw new Error(`Auth failed: ${res.status}`);
  return (await res.json()).access_token;
}

async function updateRecord(disabilityCode, payload, token) {
  const res = await fetch(
    `${BASE_URL}/api/v1/main/status/${disabilityCode}`,
    {
      method: "PUT",
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    }
  );

  if (!res.ok) {
    const err = await res.json();
    throw new Error(err.detail || `HTTP ${res.status}`);
  }

  return await res.json();
}

// ── Usage ──
const token = await getAccessToken();

// Status only
const result1 = await updateRecord(
  "PWD-2026-001234",
  { new_status: "PWD_APPROVED" },
  token
);
console.log(result1);

// Status + fields
const result2 = await updateRecord(
  "PWD-2026-005678",
  {
    new_status: "PWD_MODIFIED",
    family_name: "សុខ",
    given_name: "វិចិត្រ",
    phone_number: "0987654321",
    remarks: "កែតម្រូវទិន្នន័យ",
  },
  token
);
console.log(result2);
```

